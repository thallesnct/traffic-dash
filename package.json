{
  "name": "traffic-dashboard",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w apps/api",
    "dev:client": "npm run dev -w apps/client",
    "dev:shared": "npm run dev -w packages/shared",
    "build": "npm run build -w packages/shared && npm run build -w apps/api && npm run build -w apps/client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "load": "echo \"Error: not implemented yet\" && exit 1",
    "seed": "dotenv -- npm run seed -w apps/api",
    "db:migrate": "dotenv -- npm run prisma:migrate -w apps/api",
    "db:migrate:extend": "dotenv -- npm run prisma:migrate:extend -w apps/api",
    "test": "npm run test -w packages/shared && npm run test -w apps/api && npm run test -w apps/client",
    "test:e2e:browser": "npm run test:e2e -w apps/client",
    "typecheck": "npm run typecheck -w packages/shared && npm run typecheck -w apps/api && npm run typecheck -w apps/client"
  },
  "author": "Thalles Nascimento Carvalho <thallesnct>",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/autocannon": "^7.12.7",
    "autocannon": "^8.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13"
  }
}
